# CERNAL environment configuration.
# Copy to .env and adjust. Every variable below has a safe development default,
# so an empty .env works for local work. See docs/software-design.md §12.

# --- Django ---------------------------------------------------------------------
# config.settings.dev (local) | config.settings.prod (VPS)
DJANGO_SETTINGS_MODULE=config.settings.dev

# REQUIRED in production — prod.py raises at import time if this is unset.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production

# Comma-separated. REQUIRED in production.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production only: comma-separated https:// origins for CSRF.
# CSRF_TRUSTED_ORIGINS=https://cernal.example.org

# --- Database -------------------------------------------------------------------
# SQLite is the v1 default. Switching to Postgres is this one line:
#   DATABASE_URL=postgres://user:password@localhost:5432/cernal
DATABASE_URL=sqlite:///var/cernal.db

# --- Engine (docs/software-design.md §3, §10) ------------------------------------
# Dotted path to an engine.client.EngineClient implementation.
#   engine.client.MockEngine   deterministic fake science — dev, CI, frontend work
#   engine.client.LocalEngine  the real pipeline (Step 5)
CERNAL_ENGINE=engine.client.MockEngine

# --- Storage & uploads ----------------------------------------------------------
MEDIA_ROOT=var/media
MAX_DATASET_MB=50

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
