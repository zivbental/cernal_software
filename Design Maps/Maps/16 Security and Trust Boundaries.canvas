		{"id":"f741980cb69e4d66","type":"text","text":"# Researcher Browser\nUntrusted client from a service-security perspective.","x":-900,"y":90,"width":450,"height":190,"color":"5"},
		{"id":"292ac7d29cf64a00","type":"text","text":"# HTTPS Gateway / Platform API\nOnly intended public application surface.","x":-900,"y":400,"width":500,"height":220,"color":"5"},
		{"id":"866e9c29bc7949d4","type":"text","text":"# Platform Authorization\nEvery read/write/download:\n- authenticated identity\n- workspace membership\n- role/object permission\n- CSRF/session protections as appropriate\n- allowed host / HTTPS policy","x":100,"y":90,"width":500,"height":320,"color":"5"},
		{"id":"7034bba264214977","type":"text","text":"# Secret handling\nNever expose in browser bundles or logs:\n- PostgreSQL credentials\n- Redis credentials\n- Engine service credential\n- storage secrets\n- internal filesystem paths\n- private stack traces\n\nUse environment/secret-management appropriate to deployment.","x":100,"y":1080,"width":780,"height":340,"color":"1"},
		{"id":"7b3e1983c4d64b16","type":"text","text":"# Private Platform Worker\nHolds Engine service credential and performs service-to-service calls.","x":100,"y":780,"width":840,"height":240,"color":"5"},
		{"id":"5bcf59f6048e48b7","type":"text","text":"# Private PostgreSQL\nNot publicly exposed.","x":40,"y":575,"width":400,"height":170,"color":"2"},
		{"id":"ddf0e6d77d6448ca","type":"text","text":"# Private Redis\nNot publicly exposed; not durable authority.","x":490,"y":575,"width":400,"height":170,"color":"2"},
		{"id":"1c4072b389a44e46","type":"text","text":"# Artifact Security\n- scoped references\n- short-lived credentials where possible\n- checksums\n- authorization before Platform download\n- no unrestricted public result directory","x":1520,"y":970,"width":520,"height":310,"color":"1"},
		{"id":"5914c72aaf5a4e19","type":"text","text":"# Engine API\nAccepts only authenticated/authorized Platform services.\nStrict schema validation; reject unknown/unsafe parameters.\nPrefer polling if callback channel cannot be secured.","x":1520,"y":90,"width":520,"height":320,"color":"4"},
		{"id":"f742d74a68834d49","type":"text","text":"# Engine Workspace\n- per-job isolation\n- sanitized file handling\n- no unsanitized shell interpolation\n- restricted service/compute account\n- cleanup / retention controls","x":1520,"y":520,"width":520,"height":330,"color":"4"},
		{"id":"a84169921d0b4a6f","type":"text","text":"# HPC / Slurm\nScheduler-enforced resource limits and approved service access.\nNo arbitrary browser/user access.","x":2440,"y":565,"width":420,"height":240,"color":"6"}
	],
