	"nodes":[
		{"id":"bc7f5b0f143a4ed7","type":"group","label":"NAVIGATION","x":-1050,"y":-380,"width":2600,"height":210,"color":"3"},
		{"id":"737e28ac98e64035","type":"file","file":"CERNAL Architecture.canvas","x":-950,"y":-330,"width":360,"height":100,"color":"3"},
		{"id":"58169ca17c44499b","type":"file","file":"Maps/19 Repository and Team Ownership.canvas","x":-500,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"55af1be3cc4943f1","type":"file","file":"Maps/17 Deployment Topologies.canvas","x":-20,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"919880fbdc2f405a","type":"file","file":"Maps/08 Platform-Engine API Contract.canvas","x":460,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"4df460aa48b84e8e","type":"file","file":"Maps/09 End-to-End Analysis Sequence.canvas","x":940,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"9b15e217beeb4fa9","type":"group","label":"IMPLEMENTATION ROADMAP — VERTICAL SLICES","x":-1050,"y":-20,"width":2850,"height":1700,"color":"3"},
		{"id":"12bc1b869136467e","type":"text","text":"# Phase 1 — Freeze the boundary\nName Platform vs Engine consistently.\nAgree on first request/result schemas and status model.","x":-900,"y":80,"width":500,"height":300,"color":"3"},
		{"id":"ab0bb07710d042d8","type":"text","text":"# Phase 2 — Mock Engine service\nImplement `/v1/jobs`, status and result using deterministic fake scientific output.\nProves product integration without waiting for final science.","x":-300,"y":80,"width":500,"height":300,"color":"3"},
		{"id":"3831731ada6e4856","type":"text","text":"# Phase 3 — Platform vertical workflow\nOne user can create project → upload → configure → submit → monitor → inspect mock results.","x":300,"y":80,"width":500,"height":300,"color":"3"},
		{"id":"ac546055a98a4cb2","type":"text","text":"# Phase 4 — Local real Engine pipeline\nMove current scientific code behind Engine API using local provider and typed manifests.","x":900,"y":80,"width":500,"height":300,"color":"3"},
		{"id":"2b00b1f6e4544d11","type":"text","text":"# Phase 5 — Slurm provider\nImplement approved PowerSlurm submission, status, cancel, workspace and result collection.","x":-900,"y":520,"width":500,"height":300,"color":"3"},
		{"id":"383df9fedbb747bc","type":"text","text":"# Phase 6 — Scientific modularization\nFormalize gate interfaces, metrics, scoring profiles and reproducibility versions.","x":-300,"y":520,"width":500,"height":300,"color":"3"},
		{"id":"e8d4099680b04f87","type":"text","text":"# Phase 7 — Production-grade file flow\nChecksums, scoped references, artifact publishing, retention and authorized downloads.","x":300,"y":520,"width":500,"height":300,"color":"3"},
		{"id":"a18320a6fa1b48c9","type":"text","text":"# Phase 8 — Reliability & security\nContract tests, structured logs, alerts, backups, limits, safe retries and failure UX.","x":900,"y":520,"width":500,"height":300,"color":"3"},
		{"id":"6f4d845f40f34b69","type":"text","text":"# Phase 9 — Candidate exploration polish\nComparison, annotations, artifact previews, reports and synthesis-ready exports.","x":-600,"y":980,"width":500,"height":300,"color":"3"},
		{"id":"48b779862a7c4594","type":"text","text":"# Phase 10 — Portability validation\nRun same Engine contract with another compute provider to prove Slurm is replaceable.","x":200,"y":980,"width":500,"height":300,"color":"3"},
		{"id":"c3b009199a4b4a62","type":"text","text":"# Phase 11 — Scale only when needed\nCurrent expected load (~5 analyses/day with development bursts) does not justify premature microservices or Kubernetes.","x":800,"y":980,"width":500,"height":300,"color":"3"},
		{"id":"8b0fca99af054fd6","type":"text","text":"## Definition of the first truly useful milestone\nA researcher can complete one coherent workflow end-to-end using a **mock or provisional Engine**, while the architecture already respects the final service boundary. This prevents the web team and scientific team from blocking each other and avoids a painful split later.","x":-900,"y":1390,"width":2200,"height":220,"color":"4"}
	],
