		{"id":"9598fb7b3dab4d82","type":"text","text":"# ACCEPTED\nRequest validated and registered.","x":-900,"y":100,"width":400,"height":190,"color":"4"},
		{"id":"62dc06af32364c86","type":"text","text":"# STAGING INPUTS\nResolve scoped references, verify checksums.","x":-420,"y":100,"width":400,"height":190,"color":"4"},
		{"id":"fb06850512114a84","type":"text","text":"# TIMED OUT\nProvider/job runtime exceeds configured limit.","x":360,"y":850,"width":430,"height":190,"color":"1"},
		{"id":"4a0103df20c34d0e","type":"text","text":"# CANCELLATION REQUESTED → CANCELLING → CANCELLED\nEngine asks provider to stop, then performs safe collection/cleanup as policy allows.","x":910,"y":850,"width":650,"height":230,"color":"1"},
		{"id":"c16eb1a881e64225","type":"text","text":"## Platform mapping\nSeveral Engine states map to one product state. For example:\n`WAITING_FOR_COMPUTE` + `SUBMITTED_TO_PROVIDER` → **Queued**;\nmultiple scientific substages → **Running**;\n`COLLECTING_OUTPUTS` + `VALIDATING_OUTPUTS` + `PUBLISHING_ARTIFACTS` → **Running/Generating results** or **Importing results**, depending on product wording.","x":-900,"y":1220,"width":2430,"height":240,"color":"2"},
		{"id":"4fb7a5ffe6294d55","type":"file","file":"Maps/14 Compute Provider and Slurm.canvas","x":460,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"d0082769b6bc4df5","type":"file","file":"Maps/09 End-to-End Analysis Sequence.canvas","x":940,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"e08b29f6cc174d30","type":"text","text":"# PREPARING WORKSPACE\nCreate isolated job workspace + manifest.","x":60,"y":100,"width":400,"height":190,"color":"4"},
		{"id":"f672bdb9af6f44c5","type":"text","text":"# WAITING FOR COMPUTE\nProvider selected; awaiting scheduler capacity.","x":540,"y":100,"width":400,"height":190,"color":"4"},
		{"id":"097ee3c7690244f3","type":"text","text":"# SUBMITTED TO PROVIDER\nProvider job ID exists.","x":1020,"y":100,"width":400,"height":190,"color":"4"},
		{"id":"9658a88932cf4bdd","type":"text","text":"# COLLECTING OUTPUTS\nGather provider outputs/logs/checkpoints.","x":540,"y":480,"width":400,"height":190,"color":"4"},
		{"id":"a6c8504527ba4834","type":"text","text":"# VALIDATING OUTPUTS\nCheck expected files/schema/checksums.","x":60,"y":480,"width":400,"height":190,"color":"4"},
		{"id":"7fd013a170034499","type":"text","text":"# PUBLISHING ARTIFACTS\nCreate result manifest + approved references.","x":-420,"y":480,"width":400,"height":190,"color":"4"},
		{"id":"30ace9a6d0ef4182","type":"text","text":"# SUCCEEDED\nTerminal success; result available.","x":-900,"y":480,"width":400,"height":190,"color":"4"},
		{"id":"d247ecd70ea44aef","type":"text","text":"# REJECTED\nRequest/schema/auth/capability invalid.\nNo compute started.","x":-900,"y":850,"width":400,"height":190,"color":"1"},
		{"id":"427027eed99146c5","type":"text","text":"# FAILED\nInput staging, provider submission, scientific execution, validation or publishing can each fail with an explicit failure stage.","x":-360,"y":850,"width":600,"height":240,"color":"1"},
		{"id":"cd6208641d0c499d","type":"text","text":"# RUNNING\nScientific stages executing.","x":1080,"y":480,"width":400,"height":190,"color":"4"}
	],
