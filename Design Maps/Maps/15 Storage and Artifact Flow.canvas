		{"id":"4e7a1badd9cc460f","type":"file","file":"Maps/08 Platform-Engine API Contract.canvas","x":-20,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"259d73d7b708489b","type":"file","file":"Maps/16 Security and Trust Boundaries.canvas","x":460,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"c3e80f22d7d14674","type":"file","file":"Maps/18 Reliability Reproducibility Observability.canvas","x":940,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"ed290206df324d81","type":"group","label":"DATA, FILE & ARTIFACT FLOW","x":-1050,"y":-20,"width":2850,"height":1700,"color":"2"},
		{"id":"9c716cb2bb4c4157","type":"text","text":"# Browser\nSelects files and views/downloads authorized results.\nNever receives database or Engine service credentials.","x":-900,"y":80,"width":450,"height":250,"color":"5"},
		{"id":"204bd6824ec84176","type":"text","text":"# Platform Backend\nAuthorizes upload/download, registers checksums, versions and ownership.","x":-320,"y":80,"width":450,"height":250,"color":"5"},
		{"id":"342a130625bb4c0d","type":"text","text":"# Platform Object/File Storage\nDurable large-file storage for datasets, immutable input bundles, result artifacts and exports.","x":300,"y":80,"width":500,"height":280,"color":"2"},
		{"id":"cb55fb3a061b45ca","type":"text","text":"# PostgreSQL\nStores metadata + references, not giant matrices/archives.","x":940,"y":80,"width":420,"height":220,"color":"2"},
		{"id":"9ddcf908a522453c","type":"text","text":"# Immutable Input Bundle\nCreated when an AnalysisRun is submitted.\n\nContains/references:\n- exact dataset versions\n- checksums\n- normalized parameters\n- schema versions\n- correlation identifiers\n- reproducibility seed/options\n\nLater project edits do not alter it.","x":-900,"y":520,"width":520,"height":380,"color":"3"},
		{"id":"2b993451891b43ab","type":"text","text":"# Scoped Engine Access\nEngine receives a controlled way to read exactly the submitted inputs:\n- approved shared path, **or**\n- short-lived signed URL/reference, **or**\n- explicit staging transfer.\n\nAvoid unrestricted storage credentials.","x":-250,"y":520,"width":520,"height":350,"color":"1"},
		{"id":"d14b0c8c6db7477e","type":"text","text":"# Engine Workspace\nTemporary/intermediate execution data, logs, checkpoints and outputs.\nRetention is Engine-controlled.","x":420,"y":520,"width":460,"height":300,"color":"4"},
		{"id":"22bb81c774154d6a","type":"text","text":"# Result Manifest\nVersioned machine-readable result:\ncandidate records, scientific versions, parameters,\nwarnings, execution metadata and artifact checksums/references.","x":1020,"y":520,"width":520,"height":300,"color":"4"},
		{"id":"eef631c3fd6b4763","type":"text","text":"# Platform Result Import\nValidates manifest/schema/checksums.\nCopies or registers approved artifacts as required.\nCreates durable product candidate/result records.\nEngine-internal paths are never exposed.","x":-250,"y":1010,"width":600,"height":350,"color":"5"},
		{"id":"4fc9fb2d4fb343bb","type":"text","text":"# Authorized Download\nUser asks Platform for artifact/export.\nPlatform checks workspace/project permissions before returning a controlled download.","x":650,"y":1030,"width":620,"height":300,"color":"5"},
		{"id":"2448a875158f420a","type":"text","text":"## Checksum discipline\nChecksums should survive each transition: upload → dataset version → immutable run bundle → Engine staging → output publication → Platform artifact registration. This is the spine of provenance and helps detect stale or corrupted data.","x":-900,"y":1390,"width":2170,"height":200,"color":"2"}
	],
