	"nodes":[
		{"id":"3d124418f3fa418a","type":"group","x":-1050,"y":-20,"width":2850,"height":1550,"color":"3","label":"REPOSITORY & TEAM BOUNDARIES"},
		{"id":"eacd3da8b7504e06","type":"group","x":-1050,"y":-380,"width":2600,"height":210,"color":"3","label":"NAVIGATION"},
		{"id":"05de3e21d2bb4c7a","type":"file","file":"CERNAL Architecture.canvas","x":-950,"y":-330,"width":360,"height":100,"color":"3"},
		{"id":"5e85c6cbaa1c4f7a","type":"file","file":"Maps/01 System Boundary.canvas","x":-500,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"00287ead4f0b45a0","type":"file","file":"Maps/17 Deployment Topologies.canvas","x":-20,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"f6008b628aac4e21","type":"file","file":"Maps/08 Platform-Engine API Contract.canvas","x":460,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"95611f0b09194508","type":"text","text":"# `cernal-platform`\nSuggested structure:\n\n`frontend/`\n- React application\n\n`backend/`\n- Django project\n- apps: identity, workspaces, projects, datasets,\n  analyses, results, annotations, exports, audit\n\n`worker/`\n- Celery tasks / orchestration\n\n`deploy/`\n- Docker / compose / gateway configuration\n\nThe Platform repository consumes the Engine contract;\nit does not import Engine internals.","x":-900,"y":80,"width":620,"height":600,"color":"5"},
		{"id":"c1144f4ff36440e7","type":"text","text":"# `cernal-engine`\nSuggested structure:\n\n`api/`\n- FastAPI/other service facade\n- auth, versioning, endpoints\n\n`schemas/`\n- request/result typed models\n\n`pipeline/`\n- scientific workflow\n\n`gates/`\n- gate families\n\n`scoring/`\n- metrics + profiles\n\n`providers/`\n- slurm/local/cloud adapters\n\n`tools/`\n- external scientific tool wrappers\n\n`publishing/`\n- result manifests / artifacts\n\n`tests/`\n- scientific, contract and integration tests","x":-100,"y":80,"width":620,"height":650,"color":"4"},
		{"id":"45f4ae5a76c34481","type":"text","text":"# Ownership model\n### Platform / product team\nUX, project model, auth, storage, orchestration,\nresult presentation, exports.\n\n### Scientific Engine team\nalgorithms, gate families, scoring, external tools,\ncompute execution, result semantics.\n\n### Infrastructure / integration\ndeployment, credentials, Slurm access, monitoring,\nbackups and environment management.\n\n### Shared review\nAPI contract, schema versioning, release compatibility,\nreproducibility and security.","x":-900,"y":850,"width":900,"height":520,"color":"3"},
		{"id":"af08a805ddd14fd5","type":"text","text":"# Cross-boundary tests\n1. Contract tests against Engine OpenAPI/schema.\n2. Deterministic fixture job with known result manifest.\n3. Platform integration test using a mock Engine.\n4. Engine integration test using local compute provider.\n5. Slurm-provider integration test in approved environment.\n6. End-to-end smoke test from Platform submission to imported result.","x":150,"y":850,"width":1040,"height":430,"color":"2"},
		{"id":"43d761f037e04fd9","type":"file","file":"Maps/20 Implementation Roadmap.canvas","x":940,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"49760560eac04310","type":"text","text":"# Contract publication\nPrefer Engine-owned canonical contracts:\n- OpenAPI document\n- JSON Schema\n- result-manifest schema\n- capability/gate-family schema\n\nPlatform can generate or maintain a typed client from these artifacts.\n\nShared **contracts**, not shared application internals.","x":1070,"y":80,"width":600,"height":420,"color":"3"}
	],
	"edges":[
		{"id":"590ac6a13a364b05","fromNode":"95611f0b09194508","fromSide":"right","toNode":"49760560eac04310","toSide":"left","label":"consumes schema"},
