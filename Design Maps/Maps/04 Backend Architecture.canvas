		{"id":"286694fe652044e5","type":"group","x":-1050,"y":-30,"width":3370,"height":1790,"color":"5","label":"PLATFORM BACKEND — MODULAR MONOLITH RECOMMENDED"},
		{"id":"d68ba41c38c94ad7","type":"group","x":-1050,"y":-380,"width":2600,"height":210,"color":"3","label":"NAVIGATION"},
