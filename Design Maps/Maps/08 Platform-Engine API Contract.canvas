	"nodes":[
		{"id":"43ea0c2162364023","type":"group","label":"NAVIGATION","x":-1050,"y":-380,"width":2600,"height":210,"color":"3"},
		{"id":"a2edb6e1b1eb4c7c","type":"file","file":"CERNAL Architecture.canvas","x":-950,"y":-330,"width":360,"height":100,"color":"3"},
		{"id":"0e820e5e0ce04e1b","type":"file","file":"Maps/01 System Boundary.canvas","x":-500,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"4e39960dba194353","type":"file","file":"Maps/04 Backend Architecture.canvas","x":-20,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"77edaed8815244ab","type":"file","file":"Maps/10 Engine Architecture.canvas","x":460,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"706cda466d1d4cc0","type":"file","file":"Maps/09 End-to-End Analysis Sequence.canvas","x":940,"y":-330,"width":430,"height":100,"color":"3"},
		{"id":"3213204969fd4bf7","type":"group","label":"PLATFORM ↔ ENGINE API CONTRACT","x":-1050,"y":-20,"width":2800,"height":1600,"color":"3"},
		{"id":"e491bca183a14ad6","type":"text","text":"# Contract principles\n- Small endpoint surface\n- Asynchronous jobs\n- Explicit versioning\n- Immutable submissions\n- Idempotent creation\n- Provider independence\n- Strict typed schemas\n- Large files by controlled references, not giant JSON payloads\n- Engine authenticates the Platform service, not browser users","x":-900,"y":70,"width":500,"height":410,"color":"3"},
		{"id":"6fa0cb43337a486d","type":"text","text":"# `POST /v1/jobs`\n### Platform sends\n- API/schema version\n- platform run ID / correlation ID\n- idempotency key\n- immutable input bundle references + checksums\n- normalized parameter snapshot\n- organism / state metadata\n- requested gate families\n- scoring / reproducibility settings\n- optional callback capability\n\n### Immediate response\n`202 Accepted`\n- `engine_job_id`\n- accepted API version\n- initial technical status\n- timestamps","x":-250,"y":70,"width":600,"height":570,"color":"4"},
		{"id":"b005c38a1b4340f8","type":"text","text":"# `GET /v1/jobs/{engine_job_id}`\nReturns technical execution state:\n- accepted / staging\n- waiting for compute\n- submitted\n- running stage\n- progress metadata\n- cancellation state\n- terminal success/failure\n- warnings / safe error summary\n\nPlatform maps this into product-facing status.","x":500,"y":70,"width":520,"height":430,"color":"4"},
		{"id":"be2d4d22126646dd","type":"text","text":"# `GET /v1/jobs/{id}/result`\nAvailable after successful publication.\n\nReturns or references a **versioned Result Manifest**:\n- engine/scientific versions\n- input checksums\n- normalized parameters\n- candidate results\n- scores / metric breakdown\n- warnings\n- artifacts\n- execution metadata\n- output checksums","x":1120,"y":70,"width":520,"height":470,"color":"4"},
		{"id":"41709f41f4dc42b5","type":"text","text":"# `POST /v1/jobs/{id}/cancel`\nRecords cancellation request.\nEngine owns provider-specific cancellation and cleanup.\nResponse distinguishes:\n- requested\n- already terminal\n- cancellation in progress\n- cancelled","x":-250,"y":760,"width":520,"height":300,"color":"4"},
		{"id":"b7acfe130fce4e75","type":"text","text":"# `GET /health` / `GET /version`\nOperational endpoints for:\n- service availability\n- API compatibility\n- Engine version\n- scientific pipeline version\n- optional capabilities / gate families\n\nShould not expose secrets or sensitive infrastructure details.","x":380,"y":760,"width":540,"height":330,"color":"4"},
		{"id":"a48545f8cd4947e3","type":"text","text":"# Idempotency\nA retry after network timeout must not accidentally launch a second expensive computation.\n\nPlatform creates a unique key for one immutable AnalysisRun submission.\nEngine stores the key and returns the same `engine_job_id` for repeated equivalent requests.","x":1040,"y":760,"width":560,"height":330,"color":"2"},
		{"id":"b6aa4876db7a4a9d","type":"text","text":"# Large-data transfer\nPreferred patterns:\n1. Approved shared storage with scoped paths.\n2. Short-lived signed object references.\n3. Engine-managed upload session.\n4. Controlled copy/staging service.\n\nAvoid embedding transcriptomic matrices or archives directly in request JSON.","x":-900,"y":1150,"width":660,"height":330,"color":"2"},
		{"id":"0a53e1da68144e21","type":"text","text":"# Service authentication\nUse university-approved service credentials or a future service-to-service mechanism such as signed tokens / mTLS.\n\nThe credential belongs to the Platform backend/worker. It is **never shipped to the browser**.","x":-100,"y":1150,"width":610,"height":300,"color":"1"},
		{"id":"105ba46d6d4a4c3b","type":"text","text":"# Compatibility\nMajor API versions change only for breaking semantics.\nOpenAPI + JSON Schema should be published by the Engine.\nPlatform maintains/generated typed client and runs contract tests against the deployed Engine.","x":650,"y":1150,"width":850,"height":300,"color":"3"}
	],
	"edges":[
		{"id":"30380c8d58554e8d","fromNode":"6fa0cb43337a486d","toNode":"b005c38a1b4340f8","toEnd":"arrow","label":"poll using engine_job_id","fromSide":"right","toSide":"left"},
		{"id":"9ef4639ad66948da","fromNode":"b005c38a1b4340f8","toNode":"be2d4d22126646dd","toEnd":"arrow","label":"when succeeded","fromSide":"right","toSide":"left"},
