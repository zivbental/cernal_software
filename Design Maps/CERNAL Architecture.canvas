		{"id":"290a165104e44e92","type":"file","file":"Maps/15 Storage and Artifact Flow.canvas","x":1150,"y":1740,"width":400,"height":100,"color":"3"},
		{"id":"e731893d45be4a40","type":"file","file":"Maps/16 Security and Trust Boundaries.canvas","x":1600,"y":1740,"width":400,"height":100,"color":"3"},
		{"id":"40430f1d5b6d45c1","type":"file","file":"Maps/17 Deployment Topologies.canvas","x":2050,"y":1740,"width":400,"height":100,"color":"3"},
		{"id":"48e1e5eaae0f476c","type":"file","file":"Maps/18 Reliability Reproducibility Observability.canvas","x":2500,"y":1740,"width":400,"height":100,"color":"3"},
		{"id":"cb3c79ee09e745c6","type":"text","text":"# Researcher\nUses CERNAL as one coherent scientific application.\nNever talks directly to the Engine or Slurm.","x":-1800,"y":0,"width":360,"height":150},
		{"id":"0dbd30f038d84d66","type":"text","text":"# Frontend\n**React / Lovable-origin UI**\n\nOwns:\n- Forms and navigation\n- Upload UX\n- Progress views\n- Candidate exploration\n- Comparison and exports\n\nDoes **not** perform scientific calculations.","x":-1830,"y":270,"width":420,"height":330,"color":"5"},
		{"id":"d5e7d1a606ca45ef","type":"text","text":"# Platform Backend\n**Recommended: Django modular monolith**\n\nOwns:\n- Identity & permissions\n- Workspaces / projects\n- Dataset registration\n- Analysis-run records\n- Engine orchestration\n- Results import\n- Audit trail","x":-1200,"y":258,"width":440,"height":355,"color":"5"},
		{"id":"92968d07254d4a00","type":"text","text":"# Platform Workers\n**Redis + Celery (or equivalent)**\n\nProduct-side orchestration only:\nsubmit, poll, import, notify, cleanup, export.\n\nNever run the scientific pipeline.","x":-380,"y":30,"width":390,"height":240,"color":"5"},
		{"id":"becee063111a49ab","type":"text","text":"# PostgreSQL\nDurable product source of truth:\nusers, projects, runs, status, result summaries,\nannotations, artifact references, audit data.","x":-1190,"y":760,"width":420,"height":190,"color":"2"},
		{"id":"6b735564c0104107","type":"text","text":"# Engine Job Manager\n- Idempotency\n- Immutable run manifest\n- Provider selection\n- Cancellation\n- Retention / cleanup\n- Internal job state","x":1600,"y":40,"width":400,"height":240,"color":"4"},
		{"id":"bde36a6bc3de4e8b","type":"text","text":"# Scientific Pipeline\nCERNAL's scientific core:\n- transcriptomic preprocessing\n- trigger generation\n- gate construction\n- thermodynamic evaluation\n- scoring / ranking\n- artifact generation","x":520,"y":425,"width":450,"height":280,"color":"4"},
		{"id":"d8f31c5eadfd47a6","type":"text","text":"# Result Publisher\nProduces a versioned result manifest,\nchecksums and approved artifacts for the Platform.\n\nThe Platform imports this output into its own durable model.","x":1580,"y":510,"width":420,"height":250,"color":"4"},
		{"id":"953a5287eca44fb3","type":"text","text":"# Gate / Model Libraries\nVersioned scientific definitions:\ntoeholds, AND gates, CRISPR-derived strategies,\nscoring profiles, tool adapters and constraints.","x":520,"y":950,"width":450,"height":210,"color":"4"},
		{"id":"88b9466f0d5a4b5e","type":"text","text":"# Compute Provider Adapter\nStable interface:\n`submit`\n`get_status`\n`cancel`\n`collect_outputs`\n\nLets the Engine swap Slurm for another provider.","x":2920,"y":35,"width":420,"height":245,"color":"6"},
		{"id":"c7da936a026649c0","type":"text","text":"# PowerSlurm / HPC\nCurrent TAU compute target.\n\nEngine prepares a workspace and submission script,\ncalls `sbatch`, monitors the scheduler and collects outputs.\n\nNo public API listener on a Slurm login node.","x":2920,"y":400,"width":500,"height":280,"color":"6"},
		{"id":"d4cced9acc5949bc","type":"text","text":"# Future Compute\nPossible providers:\n- Dedicated workers / VM\n- Cloud batch\n- Another HPC cluster\n\nPlatform does not need to change if the Engine API contract stays compatible.","x":2900,"y":800,"width":500,"height":230,"color":"6"}
	],
