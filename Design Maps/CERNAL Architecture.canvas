{
	"nodes":[
		{"id":"03d542e498994f72","type":"group","x":-1250,"y":1400,"width":4350,"height":850,"color":"3","label":"DETAILED MAPS"},
		{"id":"c9e507238c8e4d63","type":"group","x":-1960,"y":-150,"width":2160,"height":1350,"color":"5","label":"CERNAL PLATFORM — user-facing software product"},
		{"id":"ea588e8b35b84cb1","type":"group","x":350,"y":-150,"width":1970,"height":1350,"color":"4","label":"CERNAL ENGINE — independent computational service"},
		{"id":"21d8e08e0689406e","type":"group","x":2760,"y":-150,"width":1050,"height":1350,"color":"6","label":"COMPUTE & INFRASTRUCTURE"},
		{"id":"c2cae70b356f469f","type":"text","text":"# Engine API\nMachine-facing, versioned service boundary.\n\nAccepts immutable job requests and returns an\n`engine_job_id` immediately.\n\nThe API hides Slurm / VM / cloud details from the Platform.","x":520,"y":40,"width":450,"height":240,"color":"4"},
		{"id":"3f5929aa1b1f4fa8","type":"text","text":"# Platform File / Object Storage\nLarge datasets, immutable input bundles,\nreports, result artifacts and exports.\n\nLarge matrices should **not** live in PostgreSQL.","x":-430,"y":760,"width":440,"height":190,"color":"2"},
