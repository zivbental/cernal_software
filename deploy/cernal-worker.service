[Unit]
Description=CERNAL scientific queue worker
After=network.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@ROOT@@
EnvironmentFile=@@ENV@@
ExecStart=@@ROOT@@/.venv/bin/python @@ROOT@@/manage.py qcluster
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=130
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@VAR@@

[Install]
WantedBy=multi-user.target
