[Unit]
Description=CERNAL web application
After=network.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@ROOT@@
EnvironmentFile=@@ENV@@
Environment=PYTHONPATH=@@ROOT@@/src
ExecStart=@@ROOT@@/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@VAR@@

[Install]
WantedBy=multi-user.target
