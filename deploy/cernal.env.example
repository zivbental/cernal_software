# Install as @@ENV@@, readable only by root and group @@GROUP@@.
DJANGO_SETTINGS_MODULE=config.settings.prod
# REQUIRED: replace before starting services; do not reuse a development key.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ALLOWED_HOSTS=@@DOMAIN@@
CSRF_TRUSTED_ORIGINS=https://@@DOMAIN@@
AUTH_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
CERNAL_VAR_DIR=@@VAR@@
DATABASE_URL=sqlite:///@@VAR@@/cernal.db
MEDIA_ROOT=@@VAR@@/media
CERNAL_ENGINE=engine.client.LocalEngine
# Shared passwordless reviewer access; set False to disable new reviewer logins.
REVIEWER_LOGIN_ENABLED=True
LOG_LEVEL=INFO
MAX_DATASET_MB=@@DATASET_MB@@
RUN_HEARTBEAT_SECONDS=10
RUN_HEARTBEAT_TIMEOUT=120
RUN_EXECUTION_TIMEOUT=3630
RUN_QUEUE_REPUBLISH_SECONDS=3660
RUN_QUEUE_TIMEOUT=7200
