[Unit]
Description=CERNAL durable job reconciler
After=network.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
WorkingDirectory=@@ROOT@@
EnvironmentFile=@@ENV@@
ExecStart=@@ROOT@@/.venv/bin/python @@ROOT@@/manage.py reconcile_runs --watch --interval 10
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@VAR@@

[Install]
WantedBy=multi-user.target
