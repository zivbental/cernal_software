[Unit]
Description=CERNAL durable job reconciler
After=network.target

[Service]
Type=simple
User=cernal
Group=cernal
WorkingDirectory=/opt/cernal
EnvironmentFile=/etc/cernal/cernal.env
ExecStart=/opt/cernal/.venv/bin/python /opt/cernal/manage.py reconcile_runs --watch --interval 10
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cernal/var

[Install]
WantedBy=multi-user.target
