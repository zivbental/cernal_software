# Report build products: regenerate with report/panel_data.py and report/panel_page.py
src/engine/gates/notebooks/toehold_and/report/panel_data.json
src/engine/gates/notebooks/toehold_and/report/panel.html

# The axis-characterisation run: one row per design, hundreds of thousands of them.
# Regenerable by tools/run_axes.cmd, and the analysis that reads them is what gets committed.
src/engine/gates/notebooks/toehold_and/results/axes_*.csv

# The analysis output: regenerated from the run by tools/analyse_axes.py, and rows.csv is large.
docs/assets/axes_*/rows.csv

# Local agent checkouts are not project submodules.
.claude/worktrees/
.claude/settings.local.json

# The split copies of the sweep output: derived from axes_*.csv by tools/split_mixed_schema.py,
# same size as the originals, and regenerable in a minute.
src/engine/gates/notebooks/toehold_and/results/axes_*_v1_*.csv
src/engine/gates/notebooks/toehold_and/results/axes_*_v2_*.csv
src/engine/gates/notebooks/toehold_and/results/axes_*_odd_*.csv

# The corrected barrier run is TRACKED, in docs/assets/barrier/. It was ignored here as
# "results, not source", which is the right rule for a 600 MB sweep and the wrong one for
# this: 16 files and 668 KB in total, produced by an overnight run nobody is going to
# repeat casually, and the only copy of the rows behind Figure 7.5, the comparison table
# in section 7.6 and the contrast in section 9.6. Ignored, they existed on one desktop.
# docs/assets/barrier/README.md records what produced them and their checksums.
#
# barrier_superseded/ stays ignored: it is the run made before the barrier was taken from
# the path rather than from path_findpath_saddle, it is wrong, and its README -- which is
# tracked -- says so. Keeping the wrong numbers out of the repository is the point of it.
docs/assets/barrier_superseded/landing_*.csv
docs/assets/barrier_superseded/designs_*.csv
docs/assets/barrier_superseded/best_*.csv
docs/assets/barrier_superseded/log_*.txt
frontend/test-results/

# Installed, byte-pinned reference packages (python tools/install_data.py).
/src/engine/data/transcriptomes/*
/vendor/ais-china-codon-optimization-v2/data/
/src/apps/expression/catalog/**/*.csv
